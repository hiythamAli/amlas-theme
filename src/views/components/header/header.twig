{#
  T-3.04 — Header, transparent-over-hero.

  Design: avatar (left, RTL-start) · centred wordmark · search + burger
  (right). Sits transparent on top of the hero image; T-3.05 adds the
  solid/sticky state on scroll by toggling `.is-stuck` on `#mainnav`, so
  that behaviour is not duplicated here.

  Works when the hero is absent (acceptance criterion): `.has-hero` is only
  added by the page template that actually renders one, and every colour
  below falls back to the solid on-white state when that class is missing.
#}
{% set important_links = theme.settings.get('important_links') %}

<header data-testid="store-header" class="store-header {{ is_page('index') ? 'has-hero' : '' }}">
  {# Top Nav — unchanged from upstream: language/currency, scopes, utility search #}
  <div class="top-navbar">
    <div class="container flex justify-between">
      <div class="flex-1 flex items-center gap-2">
        {% if important_links %}
          <salla-menu data-testid="store-header-topnav" source="footer" topnav></salla-menu>
        {% endif %}

        <div class="header-buttons">
          {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
            <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
          {% endif %}
        </div>

        {% if store.scope %}
          <button class="btn--rounded-gray" onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
            <i class="sicon-location rtl:ml-1 ltr:mr-1"></i> {{ store.scope.name }}
          </button>
        {% endif %}
      </div>

      <salla-contacts data-testid="store-header-contacts" is-header></salla-contacts>
    </div>
  </div>

  {# Main Nav — the overlay bar itself #}
  <div id="mainnav" class="main-nav-container main-nav-container--overlay flex items-center">
    <div class="inner w-full">
      <div class="container">
        <div class="grid grid-cols-3 items-center py-3">

          {# Start: avatar / account #}
          <div class="flex items-center justify-start">
            <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>
          </div>

          {# Centre: wordmark #}
          <div class="flex items-center justify-center">
            <a data-testid="store-header-logo" class="navbar-brand navbar-brand--wordmark" href="{{ store.url }}">
              <img fetchpriority="high" width="140" height="36" loading="eager"
                   src="{{ store.logo|cdn(280) }}" alt="{{ store.name }} logo">
              {% if is_page('index') %}
                <h1 class="sr-only">{{ store.name }}</h1>
              {% else %}
                <h2 class="sr-only">{{ store.name }}</h2>
              {% endif %}
            </a>
          </div>

          {# End: search, cart, burger #}
          <div class="flex items-center justify-end gap-3">
            <button data-testid="store-header-search-trigger" class="header-icon-btn"
                    aria-label="{{ 'common.elements.search'|trans }}"
                    onclick="salla.event.dispatch('search::open')">
              {% include 'components.ui.icon' with { name: 'search', size: 'lg' } %}
            </button>

            <salla-cart-summary data-testid="store-header-cart" class="header-icon-btn header-icon-btn--cart">
              <i slot="icon" class="header-btn__icon icon sicon-shopping-bag" aria-hidden="true"></i>
            </salla-cart-summary>

            <a data-testid="store-header-mobile-toggle" class="header-icon-btn lg:hidden mburger mburger--collapse"
               href="#mobile-menu" aria-label="{{ 'common.elements.open_menu'|trans|default('Open menu') }}">
              {% include 'components.ui.icon' with { name: 'menu', size: 'lg' } %}
            </a>

            <div class="hidden lg:block">
              <custom-main-menu></custom-main-menu>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</header>
