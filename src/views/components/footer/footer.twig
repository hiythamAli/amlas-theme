{#
  T-3.08 — Footer.
  Wordmark, two-column links, six social pills, Maroof badge, payment marks.

  Deliberately built on the same upstream web components already wired to
  real store data (`salla-menu`, `salla-social`, `salla-trust-badges`,
  `salla-payments`) — T-3.09's acceptance criterion is "no bundled image
  strip", which these already satisfy. This task is layout and styling, not
  new data plumbing.
#}
<footer data-testid="store-footer" class="store-footer">
  <div class="container">

    {# Wordmark #}
    <a href="{{ link('/') }}" class="store-footer__brand">
      <img src="{{ store.logo|cdn(240) }}" width="120" height="32" loading="lazy" alt="{{ store.name }}">
    </a>

    {# Two-column link grid, sourced from the store's footer menu — never hard-coded #}
    <div class="store-footer__links">
      <h3 class="store-footer__links-title">{{ 'blocks.footer.pages_links'|trans }}</h3>
      <salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences class="store-footer__menu"></salla-menu>
    </div>

    <hr class="store-footer__divider">

    {# Social — six pills, per the design #}
    <salla-social data-testid="store-footer-social" class="store-footer__social"></salla-social>

    {# Trust badge (Maroof) #}
    <div class="store-footer__trust">
      <salla-trust-badges data-testid="store-footer-trust-badges" {% if theme.settings.get('footer_is_dark') %}dark{% endif %}></salla-trust-badges>
    </div>

    {# Payment marks — platform-driven, reflects actually-enabled methods #}
    <salla-payments data-testid="store-footer-payments" class="store-footer__payments"></salla-payments>

    {# VAT, if the merchant has one configured #}
    {% if store.settings.tax.number %}
      <div class="store-footer__tax">
        {% if store.settings.tax.certificate %}
          <a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" alt="{{ store.settings.tax.number }}">
            <img width="40" height="50" src="{{ 'images/tax.png'|cdn(70,70) }}" loading="lazy" class="w-10 rounded-sm" alt="{{ 'common.elements.tax_number'|trans }}">
          </a>
        {% endif %}
        <div>
          <p class="text-sm text-secondary mb-1">{{ 'common.elements.tax_number'|trans }}</p>
          <b class="text-sm">{{ store.settings.tax.number }}</b>
        </div>
      </div>

      {% if store.settings.tax.certificate %}
        <salla-modal data-testid="store-footer-tax-modal" sub-title-first sub-title="{{ 'common.elements.tax_number'|trans }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
          <div class="flex justify-center max-w-full">
            <img class="w-full" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}">
          </div>
        </salla-modal>
      {% endif %}
    {% endif %}
  </div>

  <div class="store-footer__bar container">
    <span class="text-sm copyright-text">{% hook copyright %}</span>
  </div>
</footer>
