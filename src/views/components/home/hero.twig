{#
  T-4.05 — Hero banner section.

  Registered as a `components` entry in twilight.json (not a bare `features`
  flag) because it carries theme settings — a merchant needs to supply the
  image, quote and the three-item strip from the customiser, not get them
  hard-coded.

  component.fields consumed (see twilight.json):
    hero_image        string, image, required — the LCP element
    hero_quote        string, textarea
    hero_cta_text     string, text
    hero_cta_url      string, url
    hero_badges       collection (min 0, max 3) — each: icon, label
#}
{% set hero_image = component.hero_image %}
{% set hero_quote = component.hero_quote %}
{% set hero_cta_text = component.hero_cta_text %}
{% set hero_cta_url = component.hero_cta_url %}
{% set hero_badges = component.hero_badges|default([]) %}

{% if hero_image %}
<section class="hero" aria-label="{{ store.name }}">
  {# LCP element: eager, high priority, explicit dimensions, never lazy. #}
  <img
    class="hero__image"
    src="{{ hero_image|cdn(1200) }}"
    srcset="{{ hero_image|cdn(760) }} 760w, {{ hero_image|cdn(1200) }} 1200w, {{ hero_image|cdn(1800) }} 1800w"
    sizes="100vw"
    width="1200" height="1500"
    alt=""
    fetchpriority="high"
    loading="eager"
    decoding="async"
  >

  {% if hero_quote %}
    <blockquote class="hero__quote">
      <p>{{ hero_quote }}</p>
    </blockquote>
  {% endif %}

  {% if hero_cta_text and hero_cta_url %}
    <a href="{{ hero_cta_url }}" class="hero__cta btn btn--primary">
      {{ hero_cta_text }}
    </a>
  {% endif %}

  {% if hero_badges|length %}
    <ul class="hero__strip" role="list">
      {% for badge in hero_badges %}
        <li class="hero__badge">
          {% if badge.icon %}
            {% include 'components.ui.icon' with { name: badge.icon, size: 'sm' } %}
          {% endif %}
          <span>{{ badge.label }}</span>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</section>
{% endif %}
