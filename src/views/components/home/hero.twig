<section class="hero-banner relative w-full overflow-hidden bg-gray-100 min-h-[400px] flex items-center">
  {% if component.hero_image %}
      <img src="{{ component.hero_image }}" alt="{{ component.hero_quote }}" class="absolute inset-0 w-full h-full object-cover">
  {% endif %}
  
  <div class="container relative z-10 py-20">
      <div class="max-w-2xl text-white drop-shadow-lg">
          {% if component.hero_quote %}
              <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight">
                  {{ component.hero_quote }}
              </h1>
          {% endif %}
          
          {% if component.hero_cta_text %}
              <salla-button href="{{ component.hero_cta_url }}" color="primary" class="mt-4">
                  {{ component.hero_cta_text }}
              </salla-button>
          {% endif %}
      </div>
  </div>

  {# عرض الشارات (Badges) إذا كانت موجودة #}
  {% if component.hero_badges|length %}
      <div class="absolute bottom-0 left-0 right-0 bg-black/30 backdrop-blur-sm py-4">
          <div class="container flex justify-around items-center text-white text-sm">
              {% for badge in component.hero_badges %}
                  <div class="flex items-center gap-2">
                      {% if badge.icon %}
                          <i class="{{ badge.icon }}"></i>
                      {% endif %}
                      <span>{{ badge.text }}</span>
                  </div>
              {% endfor %}
          </div>
      </div>
  {% endif %}
</section>
